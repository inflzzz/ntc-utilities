{
  "name": "ntc-utilities",
  "version": "0.3.0",
  "description": "Utilitários desktop minimalistas, locais e privados.",
  "author": "NTC Corporation",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:bin": "powershell -ExecutionPolicy Bypass -File scripts/fetch-binaries.ps1",
    "package:win": "pnpm run prepare:bin && electron-builder --win nsis",
    "release:win": "pnpm run prepare:bin && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ntccorporation.utilities",
    "productName": "NTC Utilities",
    "icon": "build/ntc-logo.png",
    "artifactName": "NTC.Utilities.Setup.${version}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/ntc-logo.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "inflzzz",
        "repo": "ntc-utilities"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "NTC Utilities",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.4"
  }
}
