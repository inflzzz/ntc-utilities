{
  "name": "ntc-utilities",
  "version": "0.2.1",
  "description": "Utilitários desktop minimalistas — por Edu.",
  "author": "NTC Corporation",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:bin": "powershell -ExecutionPolicy Bypass -File scripts/fetch-binaries.ps1",
    "package:win": "pnpm run prepare:bin && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ntccorporation.utilities",
    "productName": "NTC Utilities",
    "icon": "build/ntc-logo.png",
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/ntc-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "NTC Utilities",
      "runAfterFinish": false,
      "include": "build/installer.nsh",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "installerHeaderIcon": "build/installer-icon.png"
    }
  }
}
