{
  "name": "ntc-utilities",
  "version": "1.2.0",
  "description": "Utilitários desktop minimalistas, locais e privados.",
  "author": "NTC Corporation",
  "license": "GPL-3.0-only",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "benchmark:storage": "node scripts/benchmark-storage-analyzer.cjs",
    "build:storage-helper": "node scripts/build-storage-scan-fast.cjs",
    "build:ambient-packs": "node scripts/build-ambient-packs.cjs",
    "validate:rng-catalog": "node scripts/validate-rng-title-catalog.cjs",
    "validate:rng-math-backend": "node scripts/validate-rng-math-backend.cjs",
    "prepare:bin": "powershell -ExecutionPolicy Bypass -File scripts/fetch-binaries.ps1",
    "package:win": "pnpm run validate:rng-catalog && pnpm run validate:rng-math-backend && node scripts/generate-echo-title-catalog.cjs && node scripts/build-rng-online-config.cjs && pnpm run build:storage-helper && pnpm run prepare:bin && electron-builder --win nsis",
    "release:win": "pnpm run validate:rng-catalog && pnpm run validate:rng-math-backend && node scripts/generate-echo-title-catalog.cjs && node scripts/build-rng-online-config.cjs && pnpm run build:storage-helper && pnpm run prepare:bin && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "gmp-wasm": "1.3.2",
    "jsqr": "^1.4.0"
  },
  "build": {
    "appId": "com.ntccorporation.utilities",
    "productName": "NTC Utilities",
    "icon": "build/ntc-logo.png",
    "artifactName": "NTC.Utilities.Setup.${version}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**",
      "content/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "FFMPEG_BUILD_INFO.md",
      "build/ntc-logo.png",
      "package.json"
    ],
    "asarUnpack": [
      "src/clipboard-listener-host.ps1",
      "src/clipboard-listener-host.cs",
      "src/autoclicker-host.ps1",
      "src/autoclicker-host.cs"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "ffprobe.exe",
          "storage-scan-fast.exe"
        ]
      },
      {
        "from": "node_modules/gmp-wasm/dist/index.umd.js",
        "to": "ntc-math-backend/1.3.2/dist/index.umd.js"
      },
      {
        "from": "resources/ntc-math-backend/1.3.2",
        "to": "ntc-math-backend/1.3.2",
        "filter": [
          "manifest.json",
          "NOTICE.md",
          "REBUILD.md",
          "LICENSE-gmp-wasm.txt",
          "source/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/ntc-logo.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "inflzzz",
        "repo": "ntc-utilities"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "NTC Utilities",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@meteocons/svg-static": "0.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "adm-zip": "^0.6.1",
    "bwip-js": "^4.11.4",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "mammoth": "^1.12.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tar": "^7.5.22",
    "yaml": "^2.9.1"
  }
}
